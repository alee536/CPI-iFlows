                <dc:Bounds height="140.0" width="100.0" x="40.0" y="100.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="Participant_Process_1" id="BPMNShape_Participant_Process_1">
                <dc:Bounds height="235.0" width="578.0" x="241.0" y="55.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_11" id="BPMNEdge_SequenceFlow_11" sourceElement="BPMNShape_CallActivity_10" targetElement="BPMNShape_EndEvent_2">
                <di:waypoint x="616.0" xsi:type="dc:Point" y="160.5"/>
                <di:waypoint x="719.0" xsi:type="dc:Point" y="160.5"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_12" id="BPMNEdge_SequenceFlow_12" sourceElement="BPMNShape_StartEvent_4" targetElement="BPMNShape_CallActivity_7">
                <di:waypoint x="295.0" xsi:type="dc:Point" y="158.0"/>
                <di:waypoint x="388.75" xsi:type="dc:Point" y="158.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_13" id="BPMNEdge_SequenceFlow_13" sourceElement="BPMNShape_CallActivity_7" targetElement="BPMNShape_CallActivity_10">
